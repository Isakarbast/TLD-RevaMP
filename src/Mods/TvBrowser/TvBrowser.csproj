<Project Sdk="Microsoft.NET.Sdk">
  <!-- Example mod for TLD Revamp's multiplayer API: a web browser on the game's TV, with replay channels (docs/MODDING-MULTIPLAYER.md). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>TvBrowser</AssemblyName>
    <RootNamespace>TvBrowser</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <PathMap>$(MSBuildProjectDirectory)=/src/$(MSBuildProjectName)</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <!-- tvbrowser-host, the browser (Host/build.sh for Proton, Host/build-windows.sh for Windows), written next to CEF's
         files when it starts -->
    <!-- WithCulture: ".so" would otherwise be read as Somali, making them a satellite assembly -->
    <EmbeddedResource Include="Host/linux-x64/*;Host/windows-x64/*" LogicalName="host.%(Filename)%(Extension)" WithCulture="false" />
    <Reference Include="$(MSBuildThisFileDirectory)../../../lib/*.dll" Private="false" />
    <ProjectReference Include="../../TLDRevamp.Multiplayer/TLDRevamp.Multiplayer.csproj" Private="false" />
  </ItemGroup>
</Project>
